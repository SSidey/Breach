; Loaded at run time by sim/skirmish/formation/native_kernels.gd when BREACH_NATIVE=cpp and
; the library has been built (native/build.sh). native/ holds a .gdignore, so the editor
; never scans it and a checkout without the binaries runs on GDScript, silently.
[configuration]
entry_symbol = "breach_cpp_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.x86_64 = "res://native/bin/libbreach_cpp.linux.x86_64.so"
windows.x86_64 = "res://native/bin/breach_cpp.windows.x86_64.dll"
macos = "res://native/bin/libbreach_cpp.macos.universal.dylib"
